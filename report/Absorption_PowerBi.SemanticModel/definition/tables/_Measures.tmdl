	measure 'Actual Absorption' = SUM(Fact_FS_Absorption[amount_cc_currency]) * -1
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: eaf5ec15-dfc7-4565-b0b7-e083ff17878c

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Variance Units % Display' = ```
			
			VAR VarPct = DIVIDE ( [Actual Units] - [AOP Units], [AOP Units], 0 )
			VAR Arrow = 
			    SWITCH ( 
			        TRUE(),
			        VarPct > 0, UNICHAR ( 8593 ),   -- ↑ Up arrow
			        VarPct < 0, UNICHAR ( 8595 ),   -- ↓ Down arrow
			        ""
			    )
			VAR Sign = IF ( VarPct >= 0, "+", "" )
			RETURN
			    Arrow & " " & Sign & FORMAT ( VarPct, "0.0%" ) & " vs AOP"
			```
		lineageTag: 4b0e9e56-a3d9-443a-8c1b-4571d1cb6ada

	measure 'Variance $ % Display' = ```
			
			VAR VarPct = DIVIDE ( [Actual Absorption $ (Abs)] - [AOP $ (Abs)], [AOP $ (Abs)], 0 )
			VAR Arrow = 
			    SWITCH ( 
			        TRUE(),
			        VarPct > 0, UNICHAR ( 8593 ),
			        VarPct < 0, UNICHAR ( 8595 ),
			        ""
			    )
			VAR Sign = IF ( VarPct >= 0, "+", "" )
			RETURN
			    Arrow & " " & Sign & FORMAT ( VarPct, "0.0%" ) & " vs AOP"
			```
		lineageTag: 67e9a140-cf90-473e-902b-0084d5ea0709

	measure Site
		lineageTag: 0396e01c-f394-4bac-9346-b6d8daa11383

	measure 'AOP Daily Average'
		lineageTag: 51764564-d766-45d3-a702-1d8cd0e7d116

	measure 'AOP Daily Average updated' = ```
			
			VAR CurrentDate = MAX ( 'Calendar'[Date] )
			VAR MonthStart = EOMONTH ( CurrentDate, -1 ) + 1
			VAR MonthEnd = EOMONTH ( CurrentDate, 0 )
			
			-- Determine which site is selected
			VAR CurrentSite = SELECTEDVALUE ( Dim_Site_Dim[site_code], "ALL" )
			
			-- Monthly AOP total (respects current filters)
			VAR MonthlyAOP = 
			    CALCULATE (
			        SUM ( Fact_AOP[aop_units] ),
			        ALL ( 'Calendar' ),
			        'Calendar'[Date] >= MonthStart,
			        'Calendar'[Date] <= MonthEnd
			    )
			
			-- Count working days based on site schedule
			VAR WorkingDays = 
			    SWITCH (
			        CurrentSite,
			        "US9F - CO01",  -- Mon-Thu
			            CALCULATE (
			                COUNTROWS ( 'Calendar' ),
			                ALL ( 'Calendar' ),
			                'Calendar'[Date] >= MonthStart,
			                'Calendar'[Date] <= MonthEnd,
			                'Calendar'[Is WorkDay MonThu] = TRUE ()
			            ),
			        "US9G",  -- Mon-Thu
			            CALCULATE (
			                COUNTROWS ( 'Calendar' ),
			                ALL ( 'Calendar' ),
			                'Calendar'[Date] >= MonthStart,
			                'Calendar'[Date] <= MonthEnd,
			                'Calendar'[Is WorkDay MonThu] = TRUE ()
			            ),
			        "US9F - CO02",  -- Mon-Fri
			            CALCULATE (
			                COUNTROWS ( 'Calendar' ),
			                ALL ( 'Calendar' ),
			                'Calendar'[Date] >= MonthStart,
			                'Calendar'[Date] <= MonthEnd,
			                'Calendar'[Is WorkDay MonFri] = TRUE ()
			            ),
			        "US9M",  -- Mon-Fri
			            CALCULATE (
			                COUNTROWS ( 'Calendar' ),
			                ALL ( 'Calendar' ),
			                'Calendar'[Date] >= MonthStart,
			                'Calendar'[Date] <= MonthEnd,
			                'Calendar'[Is WorkDay MonFri] = TRUE ()
			            ),
			        -- Default (no site selected): use Mon-Fri as a general estimate
			            CALCULATE (
			                COUNTROWS ( 'Calendar' ),
			                ALL ( 'Calendar' ),
			                'Calendar'[Date] >= MonthStart,
			                'Calendar'[Date] <= MonthEnd,
			                'Calendar'[Is WorkDay MonFri] = TRUE ()
			            )
			    )
			RETURN
			    DIVIDE ( MonthlyAOP, WorkingDays, BLANK () )
			```
		lineageTag: 456e048b-2dc4-43c4-9107-392473c5c9a1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

