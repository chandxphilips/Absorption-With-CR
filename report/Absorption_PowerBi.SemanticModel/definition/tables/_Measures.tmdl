	measure 'Is Working Day (Selected Site)' =
			
			VAR CurrentSite = SELECTEDVALUE ( Dim_Site_Dim[site_code], "ALL" )
			VAR MonThuFlag = SELECTEDVALUE ( 'Calendar'[Is WorkDay MonThu] )
			VAR MonFriFlag = SELECTEDVALUE ( 'Calendar'[Is WorkDay MonFri] )
			VAR Result =
			    SWITCH (
			        CurrentSite,
			        "US9F - CO01", MonThuFlag,
			        "US9G",        MonThuFlag,
			        "US9F - CO02", MonFriFlag,
			        "US9M",        MonFriFlag,
			        MonFriFlag   -- default
			    )
			RETURN
			    IF ( Result = TRUE (), 1, 0 )
		formatString: 0
		lineageTag: 71672e4a-0d86-4423-bc29-44437d0c1333

