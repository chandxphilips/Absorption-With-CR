	measure 'Units Variance Direction' =
			
			VAR v = [Var Units %]
			RETURN
			    SWITCH ( TRUE(),
			        v > 0, "▲ Favorable",
			        v < 0, "▼ Unfavorable",
			        "— On Plan"
			    )
		lineageTag: eb2977bf-c914-4ab3-8d43-2749933806de

	measure '$ Variance Direction' =
			
			VAR v = [Var $ %]
			RETURN
			    SWITCH ( TRUE(),
			        v < 0, "▲ Favorable",     -- for absorption, MORE negative = better
			        v > 0, "▼ Unfavorable",
			        "— On Plan"
			    )
		lineageTag: 5d87e38d-7318-4c3d-86dc-e239943fb642

	measure 'Page 2 Title' =
			
			"Selected Product: " & SELECTEDVALUE ( Product_Line_Map[product_line], "All Products" ) &
			" | Site: " & SELECTEDVALUE ( Dim_Plant[Plant Name], "All Sites" ) &
			" | " & SELECTEDVALUE ( Calendar[Year Month Short], "All Periods" )
		lineageTag: a4b3d863-94b5-4519-a257-65c7cb7ad926

	measure 'Actual Units' = ```
			
			SUMX (
			    Fact_MB51_Units,
			    VAR CurrentUOM   = RELATED ( Dim_Subassemblies_Counted[UOM] )
			    VAR IsCountedMat = NOT ISBLANK ( CurrentUOM )
			    VAR CurrentPlant = Fact_MB51_Units[plant]
			    VAR CurrentOrder = Fact_MB51_Units[order_number]
			    VAR CurrentProdLine = RELATED ( Dim_Subassemblies_Counted[Product_Line] )
			    VAR PostDate = Fact_MB51_Units[posting_date]
			    VAR PostYear = YEAR ( PostDate )
			    VAR PostMonth = MONTH ( PostDate )
			    -- Bridge is allowed at US9F only in Jan & Feb 2026
			    VAR BridgeAllowedAtUS9F = 
			        PostYear = 2026 && PostMonth IN { 1, 2 }
			    VAR IncludeRow =
			        SWITCH ( TRUE(),
			            CurrentPlant = "US9M",
			                IsCountedMat && LEFT ( CurrentOrder, 1 ) <> "5",
			            CurrentPlant = "US9G",
			                IsCountedMat && NOT ISBLANK ( CurrentOrder ) && CurrentOrder <> "",
			            CurrentPlant = "US9F" && CurrentProdLine = "BRIDGE",
			                IsCountedMat && BridgeAllowedAtUS9F,   -- ⭐ Include only Jan/Feb 2026
			            IsCountedMat
			        )
			    RETURN
			        IF ( IncludeRow, Fact_MB51_Units[qty_in_order_unit] * CurrentUOM, 0 )
			)
			```
		lineageTag: e1237539-37e5-46e8-a1b0-9c7c7a986eff

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'AOP Units' = SUM ( Fact_AOP[aop_units] )
