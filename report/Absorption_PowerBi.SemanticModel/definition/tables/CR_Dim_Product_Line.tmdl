	column is_undivided
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 89f5de86-1535-4e74-a745-7280c3403d59
		summarizeBy: none
		sourceColumn: is_undivided

		annotation SummarizationSetBy = Automatic

	column discipline =
			
			VAR Prefix = LEFT ( CR_Dim_Product_Line[product_hierarchy_display], 4 )
			VAR PC = CR_Dim_Product_Line[profit_ctr]
			RETURN
			SWITCH ( TRUE(),
			    Prefix = "9144", "IGTD",
			    Prefix = "9095", "HPM",
			    Prefix = "9133", "S&RC",
			    PC IN { "P88","BQ9","BR4","BR5","BR6","BS1","BS3","AO0","P84","BH4" }, "IGTD",
			    PC IN { "BO7","W18" }, "HPM",
			    PC IN { "DI2","DI3","DI4","DI5","DI6","DI7","DQ3","AD1","AD2","AD5" }, "S&RC",
			    "UNKNOWN"
			)
		lineageTag: 4e231727-f645-4db4-a764-554251b4230c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

