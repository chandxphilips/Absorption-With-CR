	column 'Effective Material' = ```
			
			VAR PNL = Fact_FS_Absorption[part_number_lookup]
			VAR MAT = Fact_FS_Absorption[material]
			VAR PNLExists = 
			    NOT ISBLANK ( 
			        LOOKUPVALUE ( 
			            Dim_Material_Master[material], 
			            Dim_Material_Master[material], PNL 
			        ) 
			    )
			VAR MATExists = 
			    NOT ISBLANK ( 
			        LOOKUPVALUE ( 
			            Dim_Material_Master[material], 
			            Dim_Material_Master[material], MAT 
			        ) 
			    )
			RETURN 
			    SWITCH ( 
			        TRUE(),
			        PNLExists, PNL,
			        MATExists, MAT,
			        PNL
			    )
			```
		lineageTag: ffeda981-e3c6-47c8-883c-c2b2a45a544d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'BU Desc Final' = ```
			
			VAR NaturalBU = RELATED ( Dim_Product_Tree_Leaf[long_description] )
			VAR BA = Fact_FS_Absorption[business_area]
			VAR HasMaterial = 
			    NOT ISBLANK ( Fact_FS_Absorption[material] ) 
			    && Fact_FS_Absorption[material] <> ""
			RETURN
			    SWITCH ( TRUE(),
			        NOT ISBLANK ( NaturalBU ), NaturalBU,
			        BA = "CO02" && HasMaterial, "Laser CVX300",
			        BA = "CO02", "Philips Laser System",  -- blank materials in laser BA
			        BA = "CO01", "IGT Devices Undivided",  -- Colorado disposable fallback
			        BA = "FR01", "IGT Devices Undivided",
			        BA = "PL01", "IGT Devices Undivided",
			        "Unassigned"
			    )
			```
		lineageTag: 0f31fb7f-8e67-4512-bc6f-c7a720cadd50
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'BU Desc Final Column' =
			
			VAR NaturalBU = RELATED ( Dim_Product_Tree_Leaf[long_description] )
			RETURN
			    SWITCH ( TRUE(),
			        NOT ISBLANK ( NaturalBU ), NaturalBU,
			        Fact_FS_Absorption[profit_center] = "P84", "Philips Laser System",
			        BLANK ()
			    )
		lineageTag: f8c770c5-6ed0-46c8-b0a0-b7e78bdfb9dc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

