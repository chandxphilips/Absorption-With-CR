	column 'Day of Week Number'
		formatString: 0
		lineageTag: 7f80eb55-4db9-4bcd-99aa-819188f116d4
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Day of Week Number]

		annotation SummarizationSetBy = Automatic

	column 'Is Holiday' =
			
			IF (
			    NOT ISEMPTY (
			        FILTER ( Dim_Holidays, Dim_Holidays[holiday_date] = 'Calendar'[Date] )
			    ),
			    TRUE (),
			    FALSE ()
			)
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: ad62a4e7-b3b7-4d4b-8a6c-74c30d090c6b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Is WorkDay MonThu' =
			
			VAR DOW = WEEKDAY ( 'Calendar'[Date], 2 )   -- Monday=1 ... Sunday=7
			RETURN
			    IF ( DOW >= 1 && DOW <= 4 && NOT 'Calendar'[Is Holiday], TRUE (), FALSE () )
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 3c767265-af7d-4100-8d84-8c42a0722138
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Is WorkDay MonFri' =
			
			VAR DOW = WEEKDAY ( 'Calendar'[Date], 2 )
			RETURN
			    IF ( DOW >= 1 && DOW <= 5 && NOT 'Calendar'[Is Holiday], TRUE (), FALSE () )
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 436667dc-d2c4-4c6f-a9e3-ccf90e89be19
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2026, 1, 1 ), DATE ( 2028, 12, 31 ) ),
				    "Year", YEAR ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Month Name", FORMAT ( [Date], "MMMM" ),
				    "Month Short", FORMAT ( [Date], "MMM" ),
				    "Year Month", FORMAT ( [Date], "YYYY-MM" ),
				    "Year Month Short", FORMAT ( [Date], "MMM YYYY" ),
				    "Quarter", "Q" & QUARTER ( [Date] ),
				    "Year Quarter", YEAR ( [Date] ) & " Q" & QUARTER ( [Date] ),
				    "Fiscal Period", RIGHT ( "00" & MONTH ( [Date] ), 3 ),
				    "Sort Year Month", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "Day Name", FORMAT ( [Date], "dddd" ),
				    "Day Short", FORMAT ( [Date], "ddd" ),
				    "Day of Week Number", WEEKDAY ( [Date], 2 )
				)

	annotation PBI_Id = 791e040f3da447d99f959f60547dfe41

