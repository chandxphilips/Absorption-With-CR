table '_US & CR IGT-D_Measures'
	lineageTag: 5a04fed7-aa94-42c3-9113-76ec02ee6822

	measure 'CR IGTD Actual Units' =
			
			CALCULATE(
			    [CR Actual Units],
			    CR_Dim_Product_Line[discipline] IN { "IGTD", "IGT-D" }
			)
		lineageTag: e87fc15f-71c9-41e3-9c96-e4946b5c40fc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CR IGTD AOP Units' = ```
			
			CALCULATE(
			    [CR AOP Units],
			    CR_Dim_Product_Line[discipline] IN { "IGTD", "IGT-D" }
			)
			
			```
		lineageTag: 4ea570fc-e731-4247-90af-2e800f3716b6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CR IGTD Actual Absorption' =
			
			CALCULATE(
			    [CR Actual Absorption $ (Abs)],
			    CR_Dim_Product_Line[discipline] IN { "IGTD", "IGT-D" }
			)
		lineageTag: 15cc4aef-0a20-49bb-8b22-5ed327ce64f5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CR IGTD AOP Absorption' =
			
			CALCULATE(
			    [CR AOP $ (Abs)],
			    CR_Dim_Product_Line[discipline] IN { "IGTD", "IGT-D" }
			)
		lineageTag: 0f410af1-3078-4200-9fe4-4149c6fa8dd1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'IGTD Actual Units' =
			
			VAR US =
			    CALCULATE(
			        [Actual Units],
			        TREATAS( VALUES( 'IGTD Sites'[Site] ), Dim_Site_Dim[site_code] )
			    )
			VAR CR =
			    IF( "CR9A" IN VALUES( 'IGTD Sites'[Site] ), [CR IGTD Actual Units] )
			RETURN US + CR
		formatString: #,0
		lineageTag: 17950bf3-726f-450e-b854-92a9199bf29a

	measure 'IGTD AOP Units' =
			
			VAR US =
			    CALCULATE(
			        [AOP Units],
			        TREATAS( VALUES( 'IGTD Sites'[Site] ), Dim_Site_Dim[site_code] )
			    )
			VAR CR =
			    IF( "CR9A" IN VALUES( 'IGTD Sites'[Site] ), [CR IGTD AOP Units] )
			RETURN US + CR
		formatString: #,0
		lineageTag: 6a8797cf-5ac7-415b-b910-d40f02579268

	measure 'IGTD Actual Absorption' =
			
			VAR US =
			    CALCULATE(
			        [Actual Absorption $ (Abs)],
			        TREATAS( VALUES( 'IGTD Sites'[Site] ), Dim_Site_Dim[site_code] )
			    )
			VAR CR =
			    IF( "CR9A" IN VALUES( 'IGTD Sites'[Site] ), [CR IGTD Actual Absorption] )
			RETURN US + CR
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 01cf7216-dc30-4565-af08-d8cd1640501f

	measure 'IGTD AOP Absorption' =
			
			VAR US =
			    CALCULATE(
			        [AOP $ (Abs)],
			        TREATAS( VALUES( 'IGTD Sites'[Site] ), Dim_Site_Dim[site_code] )
			    )
			VAR CR =
			    IF( "CR9A" IN VALUES( 'IGTD Sites'[Site] ), [CR IGTD AOP Absorption] )
			RETURN US + CR
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 4ebf9576-9b52-4b5a-949a-6922e48d1c9f

	measure 'IGTD Var Units' =
			
			[IGTD Actual Units] - [IGTD AOP Units]
		formatString: #,0
		lineageTag: f0bad59f-6c90-46bd-b08e-33c547743e6e

	measure 'IGTD Var $' =
			
			[IGTD Actual Absorption] - [IGTD AOP Absorption]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 982c5d32-6f63-4b30-bb82-7c8ea32da110

	measure 'IGTD Var Units %' =
			
			DIVIDE( [IGTD Var Units], [IGTD AOP Units] )
		lineageTag: e4ef43f2-07b4-45da-a2a9-5a2e21f66d06

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'IGTD Var $ %' =
			
			DIVIDE( [IGTD Var $], [IGTD AOP Absorption] )
		lineageTag: 4319e7a5-207a-4494-888a-a9eab0eb2c3b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'IGTD PL Actual Units' =
			
			VAR US =
			    CALCULATE(
			        [Actual Units],
			        TREATAS( VALUES( 'IGTD Product Lines'[Product Line] ), Product_Line_Map[product_line] ),
			        TREATAS( VALUES( 'IGTD Sites'[Site] ), Dim_Site_Dim[site_code] )
			    )
			VAR CR =
			    IF(
			        "CR9A" IN VALUES( 'IGTD Sites'[Site] ),
			        CALCULATE(
			            [CR IGTD Actual Units],
			            TREATAS( VALUES( 'IGTD Product Lines'[Product Line] ), CR_Dim_Product_Line[product_line] )
			        )
			    )
			RETURN US + CR
		formatString: #,0
		lineageTag: 55516d8c-5fc9-45d9-ae38-ca652ff37634

	measure 'IGTD PL AOP Units' =
			
			VAR US =
			    CALCULATE(
			        [AOP Units],
			        TREATAS( VALUES( 'IGTD Product Lines'[Product Line] ), Product_Line_Map[product_line] ),
			        TREATAS( VALUES( 'IGTD Sites'[Site] ), Dim_Site_Dim[site_code] )
			    )
			VAR CR =
			    IF(
			        "CR9A" IN VALUES( 'IGTD Sites'[Site] ),
			        CALCULATE(
			            [CR IGTD AOP Units],
			            TREATAS( VALUES( 'IGTD Product Lines'[Product Line] ), CR_Dim_Product_Line[product_line] )
			        )
			    )
			RETURN US + CR
		formatString: #,0
		lineageTag: 5af7a808-ab93-4117-a622-d6c3c244e540

	measure 'IGTD PL Actual Absorption' =
			
			VAR US =
			    CALCULATE(
			        [Actual Absorption $ (Abs)],
			        TREATAS( VALUES( 'IGTD Product Lines'[Product Line] ), Product_Line_Map[product_line] ),
			        TREATAS( VALUES( 'IGTD Sites'[Site] ), Dim_Site_Dim[site_code] )
			    )
			VAR CR =
			    IF(
			        "CR9A" IN VALUES( 'IGTD Sites'[Site] ),
			        CALCULATE(
			            [CR IGTD Actual Absorption],
			            TREATAS( VALUES( 'IGTD Product Lines'[Product Line] ), CR_Dim_Product_Line[product_line] )
			        )
			    )
			RETURN US + CR
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 3dd12f56-4120-436b-83bc-42a0957bd59f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'IGTD PL AOP Absorption' =
			
			VAR US =
			    CALCULATE(
			        [AOP $ (Abs)],
			        TREATAS( VALUES( 'IGTD Product Lines'[Product Line] ), Product_Line_Map[product_line] ),
			        TREATAS( VALUES( 'IGTD Sites'[Site] ), Dim_Site_Dim[site_code] )
			    )
			VAR CR =
			    IF(
			        "CR9A" IN VALUES( 'IGTD Sites'[Site] ),
			        CALCULATE(
			            [CR IGTD AOP Absorption],
			            TREATAS( VALUES( 'IGTD Product Lines'[Product Line] ), CR_Dim_Product_Line[product_line] )
			        )
			    )
			RETURN US + CR
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 62c2c491-d2ff-447b-a741-9a72629516bd

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'IGTD PL Var $ %' =
			
			IF(
			    ISBLANK( [IGTD PL AOP Absorption] ) || [IGTD PL AOP Absorption] = 0,
			    BLANK(),
			    DIVIDE( [IGTD PL Actual Absorption] - [IGTD PL AOP Absorption], [IGTD PL AOP Absorption] )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 663aeff8-f589-40a6-8c3e-7d770de9c5a6

	measure 'IGTD Header Title' =
			
			VAR SelCount = COUNTROWS( VALUES( Calendar[Year Month] ) )
			VAR TotalCount = COUNTROWS( ALL( Calendar[Year Month] ) )
			VAR Base = "IGT-D Manufacturing Absorption - US & Costa Rica"
			RETURN
			SWITCH(
			    TRUE(),
			    SelCount = TotalCount, Base,
			    SelCount = 1, Base & " - " & FORMAT( MIN( Calendar[Date] ), "MMMM YYYY" ),
			    Base & " - " & FORMAT( MIN( Calendar[Date] ), "MMM" ) & " to " & FORMAT( MAX( Calendar[Date] ), "MMM" )
			)
		lineageTag: cbb8bc3c-6e2b-4a96-8781-5caa913dafea

	measure 'IGTD Selection Summary' =
			
			VAR SiteTxt =
			    IF(
			        ISFILTERED( 'IGTD Sites'[Site] ),
			        CONCATENATEX( VALUES( 'IGTD Sites'[Site] ), 'IGTD Sites'[Site], ", " ),
			        "All Sites"
			    )
			VAR SelCount = COUNTROWS( VALUES( Calendar[Year Month] ) )
			VAR PerTxt =
			    SWITCH(
			        TRUE(),
			        NOT ISFILTERED( Calendar[Year Month] ), "All Periods",
			        SelCount = 1, FORMAT( MIN( Calendar[Date] ), "MMM YYYY" ),
			        FORMAT( MIN( Calendar[Date] ), "MMM" ) & " to " & FORMAT( MAX( Calendar[Date] ), "MMM" )
			    )
			RETURN
			    "Business: IGT-D" & UNICHAR(10) & "Site: " & SiteTxt & UNICHAR(10) & "Period: " & PerTxt
		lineageTag: 75fbbc65-ccb7-4c22-be32-b684133d6875

	measure 'IGTD PL Var $' =
			
			[IGTD PL Actual Absorption] - [IGTD PL AOP Absorption]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 863e8d9f-e822-4354-a8a9-82129401749d

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'IGTD PL Var Units %' =
			
			IF(
			    ISBLANK( [IGTD PL AOP Units] ) || [IGTD PL AOP Units] = 0,
			    BLANK(),
			    DIVIDE( [IGTD PL Actual Units] - [IGTD PL AOP Units], [IGTD PL AOP Units] )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 47c39bd8-7db4-417a-8b45-eedb54bb2fde

	measure 'IGTD PL Units Variance' =
			
			IF(
			    ISBLANK( [IGTD PL AOP Units] ) || [IGTD PL AOP Units] = 0,
			    BLANK(),
			    [IGTD PL Actual Units] - [IGTD PL AOP Units]
			)
		formatString: #,0
		lineageTag: d6be46d0-e623-4c97-b600-33c426ef6a38

	measure 'IGTD Units Variance Display' =
			
			VAR Pct = [IGTD Var Units %]
			RETURN
			IF(
			    ISBLANK( Pct ),
			    BLANK(),
			    IF( Pct < 0, "↓ ", "↑ " ) & FORMAT( ABS( Pct ), "0.0%" ) & " vs AOP"
			)
		lineageTag: 58aa255c-8477-45d3-845c-381f9e0e5c44

	measure 'IGTD Absorption Variance Display' =
			
			VAR Pct = [IGTD Var $ %]
			RETURN
			IF(
			    ISBLANK( Pct ),
			    BLANK(),
			    IF( Pct < 0, "↓ ", "↑ " ) & FORMAT( ABS( Pct ), "0.0%" ) & " vs AOP"
			)
		lineageTag: e4eeedbe-7126-4e3a-a6ee-21faf07e9355

	measure 'IGTD Units Variance Color' =
			
			IF( [IGTD Var Units %] < 0, "#C00000", "#107C10" )
		lineageTag: 6b9acf4b-3c0c-4d35-8dcb-67c054f7bf4b

	measure 'IGTD Absorption Variance Color' =
			
			IF( [IGTD Var $ %] < 0, "#C00000", "#107C10" )
		lineageTag: b50404d8-98b0-4840-9b52-28345b95e972

	partition '_US & CR IGT-D_Measures' = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
