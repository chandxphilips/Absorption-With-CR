table _CR_CS_Measures
	lineageTag: a63dae59-cfef-4948-b3cb-16b168013fea

	measure 'CR Actual Absorption $ (Abs)' = ABS ( SUM ( CR_FS_Absorption[amount_cc_currency] ) )
		lineageTag: 9f680f64-b29f-40d6-a781-fcc99d8f3dc8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CR Actual Units x' =
			
			SUMX (
			    CR_MB51,
			    VAR Hier = RELATED ( CR_Material_Master[product_hierarchy] )
			    VAR InTree =
			        NOT ISEMPTY (
			            FILTER (
			                Dim_Product_Tree_Leaf,
			                Dim_Product_Tree_Leaf[product_hierarchy_no_dashes] = Hier
			            )
			        )
			    RETURN IF ( InTree, CR_MB51[qty_in_order_unit], 0 )
			)
		isHidden
		lineageTag: 191c5323-788c-4ca0-bb27-502057069e65

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CR Actual Units' = SUM ( CR_MB51_Units[qty_in_order_unit] )
		formatString: 0
		lineageTag: 0d2e01b8-b9fb-41e5-a995-a449c81b0369

	measure 'CR Header Title' =
			
			VAR SelCount = COUNTROWS( VALUES( 'Calendar'[Year Month] ) )
			VAR TotalCount = COUNTROWS( ALL( Calendar[Year Month] ) )
			VAR MinDate = MIN( Calendar[Date] )
			VAR MaxDate = MAX( Calendar[Date] )
			VAR Base = "Costa Rica Manufacturing Absorption"
			RETURN
			SWITCH(
			    TRUE(),
			    SelCount = TotalCount, Base,
			    SelCount = 1, Base & " - " & FORMAT( MinDate, "MMMM YYYY" ),
			    Base & " - " & FORMAT( MinDate, "MMM" ) & " to " & FORMAT( MaxDate, "MMM" )
			)
		lineageTag: fbc69575-7e54-438f-b32f-97da7d7a1fa5

	measure 'CR AOP Units' = SUM ( CR_AOP_2026[aop_units] )
		formatString: 0
		lineageTag: edf63f19-f19e-40ae-b5b1-b3e05302e889

	measure 'CR AOP $ (Abs)' = ABS ( SUM ( CR_AOP_2026[aop_dollars] ) )
		lineageTag: 002a7b47-4da3-43ca-a8cc-f8503228d43b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CR Has Actuals' =
			
			VAR U = [CR Actual Units]
			VAR D = [CR Actual Absorption $ (Abs)]
			RETURN IF ( COALESCE ( U, 0 ) <> 0 || COALESCE ( D, 0 ) <> 0, 1 )
		formatString: 0
		lineageTag: 08d3f04d-630d-4506-b444-260ea868f152

	measure 'CR Has Actuals YTD for PL slicer' =
			
			VAR U = CALCULATE ( [CR Actual Units], ALL ( 'Calendar' ) )
			VAR D = CALCULATE ( [CR Actual Absorption $ (Abs)], ALL ( 'Calendar' ) )
			RETURN IF ( COALESCE ( U, 0 ) <> 0 || COALESCE ( D, 0 ) <> 0, 1 )
		formatString: 0
		lineageTag: 0a37b9a6-61a5-4213-a9a5-2bf17db4259e

	measure 'CR Var Units' = [CR Actual Units] - [CR AOP Units]
		lineageTag: 5799776a-ea21-45b1-aff3-0d42b2543c83

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CR Absorption Variance $' = [CR Actual Absorption $ (Abs)] - [CR AOP $ (Abs)]
		lineageTag: 730c8d28-9273-43ee-9196-28b3bd2a3b6f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CR Var Units %' =
			
			IF(
			    ISBLANK( [CR AOP Units] ) || [CR AOP Units] = 0,
			    BLANK(),
			    DIVIDE( [CR Actual Units] - [CR AOP Units], [CR AOP Units] )
			)
		formatString: 0%;-0%;0%
		lineageTag: d02b93dd-85ad-4a80-bfe3-39e4345a09ac

	measure 'CR Var $ %' =
			
			IF(
			    ISBLANK( [CR AOP $ (Abs)] ) || [CR AOP $ (Abs)] = 0,
			    BLANK(),
			    DIVIDE( [CR Actual Absorption $ (Abs)] - [CR AOP $ (Abs)], [CR AOP $ (Abs)] )
			)
		formatString: 0%;-0%;0%
		lineageTag: de3c6ec1-a059-4a35-8cfd-80eb506a0144

	measure 'CR Variance Units % Display' =
			
			VAR VarPct = [CR Var Units %]
			VAR Arrow = SWITCH ( TRUE(), VarPct > 0, UNICHAR ( 8593 ), VarPct < 0, UNICHAR ( 8595 ), "" )
			VAR Sgn = IF ( VarPct >= 0, "+", "" )
			RETURN Arrow & " " & Sgn & FORMAT ( VarPct, "0.0%" ) & " vs AOP"
		lineageTag: 552178e4-2eac-495a-853e-4ae7cc6ac538

	measure 'CR Variance $ % Display' =
			
			VAR VarPct = [CR Var $ %]
			VAR Arrow = SWITCH ( TRUE(), VarPct > 0, UNICHAR ( 8593 ), VarPct < 0, UNICHAR ( 8595 ), "" )
			VAR Sgn = IF ( VarPct >= 0, "+", "" )
			RETURN Arrow & " " & Sgn & FORMAT ( VarPct, "0.0%" ) & " vs AOP"
		lineageTag: 39340754-24af-48d0-966b-de017cd4a754

	measure 'Achievement %' = ```
			DIVIDE([CR Actual Absorption $ (Abs)], [CR AOP $ (Abs)]) 
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bccaebbd-640f-4b04-9b20-fcc41f8e482e

	measure 'Achievement Remaining CR' =
			
			VAR Remaining = ([CR AOP $ (Abs)] - [CR Actual Absorption $ (Abs)])
			RETURN IF(Remaining > 0, Remaining, 0)
		lineageTag: 2d1b9edc-8da1-46e8-a96e-7d445a8fe16f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Achievement Over CR' =
			
			VAR Over = [CR Actual Absorption $ (Abs)] - [CR AOP $ (Abs)]
			RETURN IF(Over > 0, Over, 0)
		lineageTag: afe3bf61-9b2e-472e-aa98-b7ba7559d974

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CR Var $ % Color' =
			
			IF( [CR Var $ %] < 0, "#C00000", "#107C10" )
		lineageTag: c401ea94-ccc1-4956-a838-cdad7bd1e62c

	measure 'CR Var Units % Color' =
			
			IF( [CR Var Units %] < 0, "#C00000", "#107C10" )
		lineageTag: 368ed548-ddb3-4218-ba48-5b709c3192eb

	measure 'CR Selection Summary' =
			
			VAR Bus = IF( ISFILTERED( CR_Dim_Product_Line[discipline] ),
			              CONCATENATEX( VALUES( CR_Dim_Product_Line[discipline] ), CR_Dim_Product_Line[discipline], ", " ),
			              "All Businesses" )
			VAR SelCount = COUNTROWS( VALUES( Calendar[Year Month] ) )
			VAR Per = SWITCH( TRUE(),
			              NOT ISFILTERED( Calendar[Year Month] ), "All Periods",
			              SelCount = 1, FORMAT( MIN( Calendar[Date] ), "MMM YYYY" ),
			              FORMAT( MIN( Calendar[Date] ), "MMM" ) & " to " & FORMAT( MAX( Calendar[Date] ), "MMM" ) )
			RETURN "Site: CR9A | Business: " & Bus & " | Period: " & Per
		lineageTag: 214a891d-d828-4582-9ad5-86296ddd07fb

	measure 'CR Units Pill Detail' =
			
			IF (
			ISBLANK ( [CR AOP Units] ) || [CR AOP Units] = 0,
			"No AOP",
			[CR Variance Units % Display]
			)
		lineageTag: 31ab44f3-03d0-429f-bbf9-f73aa96d07e4

	measure 'CR $ Pill Detail' =
			
			IF (
			ISBLANK ( [CR AOP $ (Abs)] ) || [CR AOP $ (Abs)] = 0,
			"No AOP",
			[CR Variance $ % Display]
			)
		lineageTag: 532aec34-e2c6-4646-972e-3a692ba4aa23

	measure 'CR AOP Units Card' = COALESCE ( [CR AOP Units], 0 )
		lineageTag: 97d070db-12a9-43c7-bb16-47f113edcc86

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CR AOP $ Card' = COALESCE ( [CR AOP $ (Abs)], 0 )
		lineageTag: 6e8e8c99-5219-491f-9900-da844aa79256

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CR Actual Units Card' = COALESCE ( [CR Actual Units], 0 )
		lineageTag: dd672764-44aa-443e-8993-bb5483bf15a3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CR Detail Title' =
			
			"Product Details – " &
			SELECTEDVALUE ( CR_Dim_Product_Line[product_line], "All Product Lines" )
		lineageTag: 74d904ee-016c-49d2-b9ef-f2bb184df9a3

	measure 'CR AOP Daily' = ```
			
			VAR CurrentDate = MAX ( 'Calendar'[Date] )
			VAR MonthStart  = EOMONTH ( CurrentDate, -1 ) + 1
			VAR MonthEnd    = EOMONTH ( CurrentDate, 0 )
			VAR MonthlyAOP =
			    CALCULATE (
			        [CR AOP Units],
			        ALL ( 'Calendar' ),
			        'Calendar'[Date] >= MonthStart,
			        'Calendar'[Date] <= MonthEnd
			    )
			RETURN DIVIDE ( MonthlyAOP, DAY ( MonthEnd ) )
			
			```
		lineageTag: a2ba1bd4-6ea9-436d-b84b-1c5c3fe7f045

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CR Actual Units Daily' =
			
			VAR d = MAX ( 'Calendar'[Date] )
			RETURN IF ( d <= TODAY (), COALESCE ( [CR Actual Units], 0 ) )
		lineageTag: 0188ca09-1697-4bfe-b02c-2ea82e4b65a4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CR Bullet Min' = 0
		formatString: 0
		lineageTag: 604154b9-0e46-463e-8555-264b9d404e60

	measure 'CR Bullet NI Units' = [CR AOP Units] * 0.7
