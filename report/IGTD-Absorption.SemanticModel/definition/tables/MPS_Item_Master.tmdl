	column 'Product Line'
		dataType: string
		lineageTag: 0cd799d1-c2b6-40c4-b97f-01dc18a91c95
		summarizeBy: none
		sourceColumn: Product Line

		annotation SummarizationSetBy = Automatic

	column 'Match Key'
		dataType: string
		lineageTag: 4d3e9c0b-3dc2-4991-af5c-7e2b55d38b1e
		summarizeBy: none
		sourceColumn: Match Key

		annotation SummarizationSetBy = Automatic

	column 'MPS Plan Month'
		dataType: dateTime
		formatString: Long Date
		lineageTag: bb3e40c0-1cf4-4260-84ac-9fa39d2d420b
		summarizeBy: none
		sourceColumn: MPS Plan Month

		variation Variation
			isDefault
			relationship: ddb591b1-27ce-4b62-b8ef-6faba2bb947d
			defaultHierarchy: LocalDateTable_b16f6d5d-c3b7-4efa-bd9b-aa5ee9a3efda.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition MPS_Item_Master = m
		mode: import
		source =
				let
				    Src        = MPS_All,
				    Latest     = List.Max(Src[Plan Month]),
				    LatestRows = Table.SelectRows(Src, each [Plan Month] = Latest),
				    ItemCols   = {"Site", "Business", "12NC", "Final Pack 12 NC", "Product Description", "Product Line"},
				    Items      = Table.Distinct(Table.SelectColumns(LatestRows, ItemCols)),
				    Filtered   = Table.SelectRows(Items, each [Site] <> null and [12NC] <> null
				                   and [Product Line] <> null and [Product Line] <> ""),
				    BizFix     = Table.TransformColumns(Filtered, {{"Business",
				                   each if _ = "IGT-D" then "IGTD" else if _ = "SRC" then "S&RC" else _, type text}}),
				    CleanKey   = (k) => if k = null then null
				                   else Text.TrimStart(Text.Remove(Text.From(k), {"-", " ", "\"}), "0"),
				    By12NC     = Table.AddColumn(BizFix, "Match Key", each CleanKey([12NC]), type text),
				    ByFP       = Table.AddColumn(BizFix, "Match Key", each CleanKey([Final Pack 12 NC]), type text),
				    Combined   = Table.SelectRows(Table.Combine({By12NC, ByFP}), each [Match Key] <> null and [Match Key] <> ""),
				    Deduped    = Table.Distinct(Combined, {"Match Key"}),
				    AddPlan    = Table.AddColumn(Deduped, "MPS Plan Month", each Latest, type date)
				in
				    AddPlan

	annotation PBI_ResultType = Table

