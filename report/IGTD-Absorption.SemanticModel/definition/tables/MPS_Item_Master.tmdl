table MPS_Item_Master
	lineageTag: 896501eb-1c9d-4681-8be1-880abe2c8589

	column Site
		dataType: string
		lineageTag: cc162b10-bcc7-43cf-80e3-3d552b1c5a81
		summarizeBy: none
		sourceColumn: Site

		annotation SummarizationSetBy = Automatic

	column Business
		dataType: string
		lineageTag: 329188b7-2c1c-484d-b471-308522db8c69
		summarizeBy: none
		sourceColumn: Business

		annotation SummarizationSetBy = Automatic

	column 12NC
		dataType: string
		lineageTag: dd15a346-74aa-4041-8e6b-1513f87f23b7
		summarizeBy: none
		sourceColumn: 12NC

		annotation SummarizationSetBy = Automatic

	column 'Final Pack 12 NC'
		dataType: string
		lineageTag: 48efd2ef-1ac5-4ff3-94a4-985f61e678a1
		summarizeBy: none
		sourceColumn: Final Pack 12 NC

		annotation SummarizationSetBy = Automatic

	column 'Product Description'
		dataType: string
		lineageTag: 8bc32420-73f8-4f66-bc7a-2399c70b1eaa
		summarizeBy: none
		sourceColumn: Product Description

