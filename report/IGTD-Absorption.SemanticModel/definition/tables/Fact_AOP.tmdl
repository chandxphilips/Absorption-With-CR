	column Plant = ```
			VAR cat = Fact_AOP[category]
			        RETURN IF(cat = "COS - Disposables", "US9F", IF(cat = "COS - LASERS", "US9F", IF(cat = "FREMONT", "US9M", IF(cat = "PLYMOUTH", "US9G"))))
			               
			```
		lineageTag: 20cd534c-fbfc-4638-8db2-90be25cb9e2d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Site Code' =
			
			VAR ProductLine = Fact_AOP[product_line]
			VAR IsLaser = ProductLine IN { "Philips Laser System", "Laser CVX300" }
			RETURN
			    SWITCH ( TRUE(),
			        Fact_AOP[Plant] = "US9F" && IsLaser, "US9F - CO02",
			        Fact_AOP[Plant] = "US9F", "US9F - CO01",
			        Fact_AOP[Plant] = "US9G", "US9G",
			        Fact_AOP[Plant] = "US9M", "US9M",
			        Fact_AOP[Plant]
			    )
		lineageTag: 49b9121b-0e51-43a8-a97b-39740ad0b20f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Fact_AOP = m
		mode: import
		source =
				let
				    Source = Databricks.Query(
				        "adb-8587249103137143.3.azuredatabricks.net",
				        "/sql/1.0/warehouses/25534f8556d30920",
				        [Catalog="qa_wb"]
				    )("
				        SELECT *
				        FROM qa_wb.digitalfactory.ref_cs_aop_monthly_clean
				    ")
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

