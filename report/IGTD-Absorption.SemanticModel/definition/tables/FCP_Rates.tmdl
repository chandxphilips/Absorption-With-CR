	column 'Match Key'
		dataType: string
		lineageTag: 94a55a65-d738-4d6a-a66b-2aae9f20065f
		summarizeBy: none
		sourceColumn: Match Key

		annotation SummarizationSetBy = Automatic

	partition FCP_Rates = m
		mode: import
		source =
				let
				    Source   = SharePoint.Files(SiteUrl, [ApiVersion = 15]),
				    File     = Table.SelectRows(Source, each Text.Contains([Folder Path], "/MPS_Absorption/MPS/")
				                 and [Name] = "IGT-D FCPs 2026.xlsx"),
				    Book     = Excel.Workbook(File{0}[Content], null, true),
				    Sheet    = Book{[Item = "US+CR", Kind = "Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars = true]),
				    First19  = Table.SelectColumns(Promoted, List.FirstN(Table.ColumnNames(Promoted), 19)),
				    NewNames = {"Material","Old PN","Site","Site Name","Category","Family DP","Status","FAM-FG",
				                "Material Dashed","Description","Material Cost","Sub Con","Freight",
				                "Labor","Overhead","Abs per Unit","FCP","Uplift 5%","TP"},
				    Renamed  = Table.RenameColumns(First19, List.Zip({Table.ColumnNames(First19), NewNames})),
				    NoErrors = Table.ReplaceErrorValues(Renamed, List.Transform(NewNames, each {_, null})),
				    Keyed    = Table.AddColumn(NoErrors, "Match Key", each
				                 if [Material] = null then null
				                 else Text.TrimStart(Text.Remove(Text.From([Material]), {"-", " "}), "0"), type text),
				    RealRows = Table.SelectRows(Keyed, each [Site] <> null and [Match Key] <> null
				                 and Text.Length([Match Key]) >= 10 and (try Number.From([Match Key]) otherwise null) <> null),
				    ToNum    = (v) => try Number.From(v) otherwise 0,
				    Nums     = Table.TransformColumns(RealRows, {
				                 {"Material Cost", ToNum, type number}, {"Labor", ToNum, type number},
				                 {"Overhead", ToNum, type number}, {"Abs per Unit", ToNum, type number},
				                 {"FCP", ToNum, type number}, {"Site", Text.Trim, type text}}),
				    Deduped  = Table.Distinct(Nums, {"Site", "Match Key"})
				in
				    Deduped

	annotation PBI_ResultType = Table

