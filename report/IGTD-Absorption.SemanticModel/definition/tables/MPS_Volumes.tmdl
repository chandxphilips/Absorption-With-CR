	column 'Rate Source'
		dataType: string
		lineageTag: adc733e7-6b0d-4462-a67a-591fad65b950
		summarizeBy: none
		sourceColumn: Rate Source

		annotation SummarizationSetBy = Automatic

	partition MPS_Volumes = m
		mode: import
		source =
				let
				    Src       = MPS_All,
				    Filtered  = Table.SelectRows(Src, each [Site] <> null and [12NC] <> null
				                  and [Product Line] <> null and [Units] <> 0),
				    BizFix    = Table.TransformColumns(Filtered, {{"Business",
				                  each if _ = "IGT-D" then "IGTD" else if _ = "SRC" then "S&RC" else _, type text}}),
				    AddFirst  = Table.AddColumn(BizFix, "Is Plan First Month", each [Month] = [Plan Month], type logical),
				    SiteMap   = Table.AddColumn(AddFirst, "Report Site", each
				                  let s = Text.Trim(Text.From([Site])) in
				                  if s = "CR" then "CR9A" else if s = "COS" then "US9F"
				                  else if s = "PLY" then "US9G" else if s = "FRE" then "US9M" else s, type text),
				    CleanKey  = (k) => if k = null then null
				                  else Text.TrimStart(Text.Remove(Text.From(k), {"-", " ", "\"}), "0"),
				    Key1      = Table.AddColumn(SiteMap, "Match Key", each CleanKey([12NC]), type text),
				    Key2      = Table.AddColumn(Key1, "Match Key FP", each CleanKey([Final Pack 12 NC]), type text),
				
				    Rates     = Table.Buffer(Table.SelectColumns(FCP_Rates, {"Site", "Match Key", "Abs per Unit"})),
				    AnySite   = Table.Buffer(Table.Distinct(Table.SelectRows(
				                  Table.SelectColumns(FCP_Rates, {"Match Key", "Abs per Unit"}),
				                  each [Abs per Unit] > 0), {"Match Key"})),
				    Overrides = Table.Buffer(Table.TransformColumnTypes(
				                  Table.SelectColumns(FCP_Overrides, {"Match Key", "Override Abs"}),
				                  {{"Match Key", type text}, {"Override Abs", type number}})),
				
				    J1        = Table.NestedJoin(Key2, {"Report Site", "Match Key"}, Rates, {"Site", "Match Key"}, "R1", JoinKind.LeftOuter),
				    J2        = Table.NestedJoin(J1, {"Report Site", "Match Key FP"}, Rates, {"Site", "Match Key"}, "R2", JoinKind.LeftOuter),
				    J3        = Table.NestedJoin(J2, {"Match Key"}, Overrides, {"Match Key"}, "R3", JoinKind.LeftOuter),
				    J4        = Table.NestedJoin(J3, {"Match Key"}, AnySite, {"Match Key"}, "R4", JoinKind.LeftOuter),
				
				    AddSource = Table.AddColumn(J4, "Rate Source", each
				                  if not Table.IsEmpty([R1]) then "Exact"
				                  else if not Table.IsEmpty([R2]) then "Final Pack"
				                  else if not Table.IsEmpty([R3]) then "Override"
				                  else if not Table.IsEmpty([R4]) then "Other Site"
				                  else null, type text),
				    AddRate   = Table.AddColumn(AddSource, "Abs per Unit", each
				                  if [Rate Source] = "Exact" then [R1]{0}[Abs per Unit]
				                  else if [Rate Source] = "Final Pack" then [R2]{0}[Abs per Unit]
				                  else if [Rate Source] = "Override" then [R3]{0}[Override Abs]
				                  else if [Rate Source] = "Other Site" then [R4]{0}[Abs per Unit]
				                  else null, type number),
				    AddUSD    = Table.AddColumn(AddRate, "MPS Absorption $", each
				                  if [Abs per Unit] = null then null else [Units] * [Abs per Unit], type number),
				    Final     = Table.RemoveColumns(AddUSD, {"R1", "R2", "R3", "R4"}),
				    Typed     = Table.TransformColumnTypes(Final, {
				                  {"Month", type date}, {"Plan Month", type date}, {"Units", type number},
				                  {"Site", type text}, {"Business", type text}, {"12NC", type text},
				                  {"Final Pack 12 NC", type text}, {"Product Description", type text},
				                  {"Product Line", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table

