	column Material_Text
		dataType: string
		lineageTag: b1480e77-3009-4fb9-a662-a23b4887f5ce
		summarizeBy: none
		sourceColumn: Material_Text

		annotation SummarizationSetBy = Automatic

	column TLA
		dataType: string
		lineageTag: 2b1ea573-3c43-4160-8c7e-265803f4ff4f
		summarizeBy: none
		sourceColumn: TLA

		annotation SummarizationSetBy = Automatic

	column Site
		dataType: string
		lineageTag: d5a425c0-bf04-4172-9411-af66f507f448
		summarizeBy: none
		sourceColumn: Site

		annotation SummarizationSetBy = Automatic

	column UOM
		dataType: string
		lineageTag: 90e79cde-7924-40ec-80c6-7b3d816a356f
		summarizeBy: none
		sourceColumn: UOM

		annotation SummarizationSetBy = Automatic

	column 'Plant Code' =
			
			SWITCH(
			    TRUE(),
			    [Site] = "PLY", "US9G",
			    [Site] = "FRE", "US9M",
			    [Site] = "COS" && [Product_Line] = "PLS", "US9F - CO02",
			    [Site] = "COS", "US9F - CO01",
			    BLANK()
			)
		lineageTag: 46d58637-8930-4f41-87c3-63537382805a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Added By'
		dataType: string
		lineageTag: 19d26f65-ef8c-4cf4-8d54-65084eca124c
		summarizeBy: none
		sourceColumn: Added By

		annotation SummarizationSetBy = Automatic

	partition Dim_Subassemblies_Counted = m
		mode: import
		source =
				let
				    Source = Databricks.Query(
				        "adb-8587249103137143.3.azuredatabricks.net",
				        "/sql/1.0/warehouses/25534f8556d30920",
				        [Catalog="qa_wb"]
				    )("
				        SELECT *
				        FROM qa_wb.digitalfactory.ref_subassemblies_counted
				    "),
				    Base = Table.AddColumn(Source, "Added By", each "Reference table", type text),
				
				    // ---- Parts approved by Sandy (add rows here as they are confirmed) ----
				    Approved = Table.FromRecords({
				        [TLA = null, FPA = "3000-115-20761", Product_Line = "BRIDGE",
				         Material_Text = "300011520761", Site = "PLY", UOM = 1, #"Added By" = "Approved - pending Databricks"],
				        [TLA = null, FPA = "9899-300-09432", Product_Line = "Stellarex",
				         Material_Text = "989930009432", Site = "PLY", UOM = 1, #"Added By" = "Approved - pending Databricks"]
				    }),
				
				    // Skip any approved part once it exists in the Databricks table
				    Existing = List.Buffer(List.Transform(Source[Material_Text], each Text.From(_))),
				    ToAdd    = Table.SelectRows(Approved, each not List.Contains(Existing, [Material_Text])),
				    Final    = Table.Combine({Base, ToAdd})
				in
				    Final

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

