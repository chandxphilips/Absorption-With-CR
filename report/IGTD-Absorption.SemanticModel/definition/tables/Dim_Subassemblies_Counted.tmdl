	column UOM
		dataType: int64
		formatString: 0
		lineageTag: 90e79cde-7924-40ec-80c6-7b3d816a356f
		summarizeBy: sum
		sourceColumn: UOM

		annotation SummarizationSetBy = Automatic

	column 'Plant Code' =
			
			SWITCH(
			    TRUE(),
			    [Site] = "PLY", "US9G",
			    [Site] = "FRE", "US9M",
			    [Site] = "COS" && [Product_Line] = "PLS", "US9F - CO02",
			    [Site] = "COS", "US9F - CO01",
			    BLANK()
			)
		lineageTag: 46d58637-8930-4f41-87c3-63537382805a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Dim_Subassemblies_Counted = m
