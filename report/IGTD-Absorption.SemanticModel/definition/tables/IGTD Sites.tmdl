table 'IGTD Sites'
	lineageTag: d902b253-0be1-41a1-a7bd-9f148029ea60

	column Site
		lineageTag: 68e509c9-1bfc-4955-abf2-4ebcf50ef2fd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Site]

		annotation SummarizationSetBy = Automatic

	column Country
		lineageTag: edacba9f-286e-4b7d-889b-cdb155e9191b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Country]

		annotation SummarizationSetBy = Automatic

	column 'MPS Report Site' =
			
			VAR SiteLabel = 'IGTD Sites'[Site]
			VAR SeparatorPosition = SEARCH(" - ", SiteLabel, 1, 0)
			RETURN
			    IF(
			        SeparatorPosition > 0,
			        LEFT(SiteLabel, SeparatorPosition - 1),
			        SiteLabel
			    )
		lineageTag: 6121b393-79a0-48bd-a48a-0d2252b8e3fa
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Site Display' =
			
			VAR SeparatorPosition =
			    SEARCH ( " - ", 'IGTD Sites'[Site], 1, 0 )
			RETURN
			    IF (
			        SeparatorPosition > 0,
			        LEFT ( 'IGTD Sites'[Site], SeparatorPosition - 1 ),
			        'IGTD Sites'[Site]
			    )
		lineageTag: 3daed6ee-76a3-4930-a79c-fa45a14f3107
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'IGTD Sites' = calculated
		mode: import
		source =
				
				VAR USSites =
				    SELECTCOLUMNS(
				        FILTER(
				            DISTINCT( Dim_Site_Dim[site_code] ),
				            NOT ISBLANK( Dim_Site_Dim[site_code] ) && Dim_Site_Dim[site_code] <> "CR9A"
				        ),
				        "Site", Dim_Site_Dim[site_code],
				        "Country", "US"
				    )
				VAR CRSites =
				    DATATABLE(
				        "Site", STRING,
				        "Country", STRING,
				        {
				            { "CR9A - CR01", "Costa Rica" },
				            { "CR9A - CR02", "Costa Rica" }
				        }
				    )
				RETURN
				    UNION( USSites, CRSites )

	annotation PBI_Id = 616a39271ccc4847a81a26704afba4d4

