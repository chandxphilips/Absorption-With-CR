	partition 'IGTD Material Detail' = calculated
		mode: import
		source =
				
				DISTINCT (
				    UNION (
				        SELECTCOLUMNS (
				            FILTER (
				                Dim_Material_Master,
				                NOT ISBLANK ( Dim_Material_Master[material] )
				            ),
				            "Region", "US",
				            "Material", Dim_Material_Master[material],
				            "Description", Dim_Material_Master[material_description]
				        ),
				        SELECTCOLUMNS (
				            FILTER (
				                CR_Material_Master,
				                NOT ISBLANK ( CR_Material_Master[material] )
				            ),
				            "Region", "CR",
				            "Material", CR_Material_Master[material],
				            "Description", CR_Material_Master[material_description]
				        )
				    )
				)

	annotation PBI_Id = da7b938b01af475595a7988b50159771

