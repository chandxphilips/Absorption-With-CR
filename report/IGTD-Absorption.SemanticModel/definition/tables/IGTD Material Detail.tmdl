table 'IGTD Material Detail'
	lineageTag: a2d60d8e-070c-49a0-b933-f5ac0fad51d1

	measure 'IGTD Detail Actual Units' =
			
			VAR MaterialKeysUS =
			    CALCULATETABLE (
			        VALUES ( 'IGTD Material Detail'[Material] ),
			        KEEPFILTERS ( 'IGTD Material Detail'[Region] = "US" )
			    )
			VAR MaterialKeysCR =
			    CALCULATETABLE (
			        VALUES ( 'IGTD Material Detail'[Material] ),
			        KEEPFILTERS ( 'IGTD Material Detail'[Region] = "CR" )
			    )
			VAR ProductLines =
			    VALUES ( 'IGTD Product Lines'[Product Line] )
			VAR Sites =
			    VALUES ( 'IGTD Sites'[Site] )
			VAR RowRegion =
			    SELECTEDVALUE ( 'IGTD Material Detail'[Region] )
			VAR USSelected =
			    COUNTROWS (
			        FILTER ( Sites, LEFT ( 'IGTD Sites'[Site], 2 ) = "US" )
			    ) > 0
			VAR CRSelected =
			    COUNTROWS (
			        FILTER ( Sites, LEFT ( 'IGTD Sites'[Site], 2 ) = "CR" )
			    ) > 0
			VAR US =
			    IF (
			        USSelected && ( ISBLANK ( RowRegion ) || RowRegion = "US" ),
			        CALCULATE (
			            [Actual Units],
			            TREATAS ( ProductLines, Product_Line_Map[product_line] ),
			            TREATAS ( Sites, Dim_Site_Dim[site_code] ),
			            TREATAS ( MaterialKeysUS, Dim_Material_Master[material] )
			        )
			    )
			VAR CR =
			    IF (
			        CRSelected && ( ISBLANK ( RowRegion ) || RowRegion = "CR" ),
			        CALCULATE (
			            [CR IGTD Site Actual Units],
			            TREATAS ( ProductLines, CR_Dim_Product_Line[product_line] ),
			            TREATAS ( MaterialKeysCR, CR_Material_Master[material] )
			        )
			    )
			RETURN
			    US + CR
		lineageTag: ee89ac58-c07b-40e7-85c3-ce60a971188c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'IGTD Detail Actual Absorption' =
			
			VAR MaterialKeysUS =
			    CALCULATETABLE (
			        VALUES ( 'IGTD Material Detail'[Material] ),
			        KEEPFILTERS ( 'IGTD Material Detail'[Region] = "US" )
			    )
			VAR MaterialKeysCR =
			    CALCULATETABLE (
			        VALUES ( 'IGTD Material Detail'[Material] ),
			        KEEPFILTERS ( 'IGTD Material Detail'[Region] = "CR" )
			    )
			VAR ProductLines =
			    VALUES ( 'IGTD Product Lines'[Product Line] )
			VAR Sites =
			    VALUES ( 'IGTD Sites'[Site] )
			VAR RowRegion =
			    SELECTEDVALUE ( 'IGTD Material Detail'[Region] )
			VAR USSelected =
			    COUNTROWS (
			        FILTER ( Sites, LEFT ( 'IGTD Sites'[Site], 2 ) = "US" )
			    ) > 0
			VAR CRSelected =
			    COUNTROWS (
			        FILTER ( Sites, LEFT ( 'IGTD Sites'[Site], 2 ) = "CR" )
			    ) > 0
			VAR US =
			    IF (
			        USSelected && ( ISBLANK ( RowRegion ) || RowRegion = "US" ),
			        CALCULATE (
			            [Actual Absorption $ (Abs)],
			            TREATAS ( ProductLines, Product_Line_Map[product_line] ),
			            TREATAS ( Sites, Dim_Site_Dim[site_code] ),
			            TREATAS ( MaterialKeysUS, Dim_Material_Master[material] )
			        )
			    )
			VAR CR =
			    IF (
			        CRSelected && ( ISBLANK ( RowRegion ) || RowRegion = "CR" ),
			        CALCULATE (
			            [CR Actual Absorption $ (Abs)],
			            TREATAS ( ProductLines, CR_Dim_Product_Line[product_line] ),
			            TREATAS ( MaterialKeysCR, CR_FS_Absorption[part_number_lookup] )
			        )
			    )
			RETURN
			    US + CR
		lineageTag: 12cd7537-255b-430f-a41a-af79f462b967

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'IGTD Detail MPS Units' =
			
			VAR MaterialKeysUS =
			    CALCULATETABLE (
			        VALUES ( 'IGTD Material Detail'[Material] ),
			        KEEPFILTERS ( 'IGTD Material Detail'[Region] = "US" )
			    )
			VAR MaterialKeysCR =
			    CALCULATETABLE (
			        VALUES ( 'IGTD Material Detail'[Material] ),
			        KEEPFILTERS ( 'IGTD Material Detail'[Region] = "CR" )
			    )
			VAR USKeyRows =
			    FILTER (
			        ALL ( MPS_Volumes[Match Key FP], MPS_Volumes[Match Key] ),
			        MPS_Volumes[Match Key FP] IN MaterialKeysUS
			            || MPS_Volumes[Match Key] IN MaterialKeysUS
			    )
			VAR Sites =
			    VALUES ( 'IGTD Sites'[Site] )
			VAR RowRegion =
			    SELECTEDVALUE ( 'IGTD Material Detail'[Region] )
			VAR USSelected =
			    COUNTROWS (
			        FILTER ( Sites, LEFT ( 'IGTD Sites'[Site], 2 ) = "US" )
			    ) > 0
			VAR CRSelected =
			    COUNTROWS (
			        FILTER ( Sites, LEFT ( 'IGTD Sites'[Site], 2 ) = "CR" )
			    ) > 0
			VAR US =
			    IF (
			        USSelected && ( ISBLANK ( RowRegion ) || RowRegion = "US" ),
			        CALCULATE (
			            [IGTD PL MPS Units],
			            KEEPFILTERS ( USKeyRows )
			        )
			    )
			VAR CR =
			    IF (
			        CRSelected && ( ISBLANK ( RowRegion ) || RowRegion = "CR" ),
			        CALCULATE (
			            [IGTD PL MPS Units],
			            TREATAS ( MaterialKeysCR, MPS_Volumes[Match Key] )
			        )
			    )
			RETURN
			    US + CR
		lineageTag: afc926c0-721d-4b4f-870f-2e82af939b65

		annotation PBI_FormatHint = {"isGeneralNumber":true}

