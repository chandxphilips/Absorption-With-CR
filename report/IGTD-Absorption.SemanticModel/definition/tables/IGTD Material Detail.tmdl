			RETURN
			    US + CR
		lineageTag: 80d5e413-a6cf-48f8-a979-00c3fffcc479

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'IGTD Detail Row Visible' =
			
			VAR Sites =
			    VALUES ( 'IGTD Sites'[Site] )
			VAR RowRegion =
			    SELECTEDVALUE ( 'IGTD Material Detail'[Region] )
			VAR USSelected =
			    COUNTROWS (
			        FILTER ( Sites, LEFT ( 'IGTD Sites'[Site], 2 ) = "US" )
			    ) > 0
			VAR CRSelected =
			    COUNTROWS (
			        FILTER ( Sites, LEFT ( 'IGTD Sites'[Site], 2 ) = "CR" )
			    ) > 0
			RETURN
			    IF (
			        ( RowRegion = "US" && USSelected )
			            || ( RowRegion = "CR" && CRSelected )
			            || ( ISBLANK ( RowRegion ) && ( USSelected || CRSelected ) ),
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 761687a4-d41f-4267-bdc3-8e3968cf4b8a

	column Region
		lineageTag: 67b26ee8-9389-4683-a572-7a4dede718e7
